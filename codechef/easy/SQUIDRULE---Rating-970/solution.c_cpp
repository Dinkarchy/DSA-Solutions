#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin>>T;
    while(T--){
        int n;
        cin>>n;
        vector<long>arr(n);
        
        for(int i=0; i<n; i++){
            cin>>arr[i];
        }
        
        int min = arr[0];
        for(int i=0; i<n; i++){
            if(arr[i] < min){
            min = arr[i];
            }
        }
            
        
        int sum =0;
        for(int i=0; i<n; i++){
            sum+= arr[i];
        }
        
        cout<<sum-min<<endl;

       
        
    }
}
