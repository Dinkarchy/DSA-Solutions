#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        int a[n],b[n];
        for(int i=0;i<n;i++){
            cin>>a[i];
        }
        for(int i=0;i<n;i++){
            cin>>b[i];
        }
    
    
        int count =0;
        int count1 =0;
        int temp =0;
        int temp1 =0;
    
        for(int i=0; i<n; i++){
            if(a[i]){
                count++;
                if(count > temp){
                    temp=count;
                }
            }
            else{
                count =0;
            }
        }
    
        for(int i=0; i<n; i++){
            if(b[i]){
                count1++;
                if(count1 > temp1){
                    temp1=count1;
                }
            }
            else{
                count1 =0;
            }
        }
    
        if(temp > temp1){
            cout<<"OM"<<endl;
        }
        else if(temp<temp1){
            cout<<"ADDY"<<endl;
        }
        else{
            cout<<"DRAW"<<endl;
        }
    }
    
    
}
