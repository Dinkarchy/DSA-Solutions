class Solution {
public:
    int findMaximumPairs(const string &students) {
        int t;
        cin>>t;
        while(t--){
            
            int count =0;
            for(int i=0; i<students.size()-1; i++){
                if(students[i] == 'x' && students == 'y'){
                    count++;
                }
            }
            
            return count;
        }
        
    }
};
