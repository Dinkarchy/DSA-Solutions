class Solution {
public:
    int findMaximumPairs(const string &students) {
        int t;
        cin>>t;
        while(t--){
            string s;
            cin>>s;
            
            int count =0;
            for(int i=0; i<s.size(); i++){
                if(s[i] == 'x' && s[i+1] == 'y'){
                    count++;
                }
            }
            
            cout<<count<<endl;
        }
        
    }
};
