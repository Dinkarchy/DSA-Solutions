class Solution {
public:
    int findMaximumPairs(const string &students) {
        int t;
        cin>>t;
        while(t--){
            
            int count =0;
            for(int i=0; i<(int)students.length(); i++){
                if((students[i] == 'x' || students[i+1] == 'x') && (students[i] == 'y' || students[i+1] == 'y')){
                    count++;
                    i++;
                }
            }
            
            return count;
        }
        
    }
};
