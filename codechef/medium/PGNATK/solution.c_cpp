#include <bits/stdc++.h>
using namespace std;

int main() {
	long t;
	cin>>t;
	while(t--){
	    int n,k;
	    cin>>n>>k;
	    
	    int total=0;
	    int work =0;
	    
	    while(work < n){
	        total++;
	        if(total % k !=0){
	            work++;
	        }
	    }
	    
	    cout<<total<<endl;
	    
	}

}
