#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n,k;
	    cin>>n>>k;
	    
	    int count=0;
	    if(k>n){
	        cout<<n<<endl;;
	    }
	    else{
	        for(int i=0; i<n; i++){
	            if(i%k == 0){
	                count++;
	            }
	        }
	            cout<<n+count<<endl;
	    }
	    
	}

}
