#include <iostream>
using namespace std;

int main() {
    int n;
    cin>>n;
    
    int arr[n];
    
    for(int i=0; i<n; i++){
        cin>>arr[i];
    }
    
    int s=0;
    int temp=0;
    for(int i=0; i<n; i++){
        if(arr[i] != 0){
            s++;
            if(temp < s){
                temp =s;
            }
        }
        else{
            s=0;
        }
    }
    
    cout<<temp;
}
