#include <bits/stdc++.h>
#include <string>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        string s;
        cin>>s;
        
        int sum =0;
        for( auto ch : s){
            if(isdigit(ch)){
                sum += ch - '0';
            }
        }
        
        
        cout<<sum<<endl;
    }
    
    return 0;
}
