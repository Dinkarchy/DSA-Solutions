#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin>>n;
    
    int arr[n];
    
    for(int i=0; i<n; i++){
        cin>>arr[i];
    }
    
    int k = (arr[0]+arr[n-1])/ 2;
    int sm = INT_MAX;
    int m;
    for(int i=0; i<n; i++){
        if(arr[i] == k){
            cout<<arr[i];
        }
        else{
            if(abs(k-arr[i])<sm ){
                sm = abs(k-arr[i]);
            }
            else if(abs(k-arr[i])< sm && abs(k-arr[i]) == sm){
                m = abs(k-arr[i]);
            }
            
        }
        
    }
}
