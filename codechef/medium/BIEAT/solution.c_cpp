#include <bits/stdc++.h>
using namespace std;

int main() {
    int N;
    cin >> N;

    vector<long long> A(N);

    for (int i = 0; i < N; i++)
        cin >> A[i];

    int M;
    cin >> M;

    for (int i = 0; i < N; i++) {
        A[i] >>= M;
        cout << A[i] << " ";
    }

    return 0;
}